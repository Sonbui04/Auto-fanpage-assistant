TELEGRAM_BOT_TOKEN=
# Telegram user ID được phép điều khiển bot. Có thể nhập nhiều ID, cách nhau bằng dấu phẩy.
TELEGRAM_ADMIN_IDS=

# Không bắt buộc. Nếu để trống, bot tạo bản nháp bằng cách trích xuất nội dung cơ bản.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Dùng 9Router local: http://localhost:20128/v1
OPENAI_BASE_URL=

# Meta Graph API - Page Access Token, không phải mật khẩu Facebook.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v25.0

TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_PATH=./data/fanpage.db
# true: bài đến lịch vẫn cần trạng thái approved. Nên giữ true.
REQUIRE_APPROVAL=true
